# Connection used by the application running directly on the host
# (docker compose db is published on host port 5433)
DB_URL=jdbc:postgresql://localhost:5433/studora
DB_USERNAME=studora
DB_PASSWORD=studora

# Values used by docker compose (db service and app service)
POSTGRES_DB=studora
POSTGRES_USER=studora
POSTGRES_PASSWORD=studora
DB_HOST_PORT=5433
APP_HOST_PORT=4534

# Observability stack (--profile observability)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_HOST_PORT=3000
